@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <https://knuckles-team.github.io/ontology/connector/technitium-dns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Technitium DNS ontology — authoritative zones, DNS records, DNSSEC signing keys, and
# the DNS server node that hosts them. All classes/properties live in the shared `:` (kg#)
# namespace; only the owl:Ontology node gets the per-package IRI. Backs the technitium-dns-mcp
# tool surface (technitium_dns_list_zones, technitium_dns_get_records, technitium_dns_get_stats, ...).

# --- classes (owl:Class) ---

:DnsZone a owl:Class ;
    rdfs:subClassOf core:ResourceGroup ;
    rdfs:label "DNS Zone" ;
    rdfs:comment "An authoritative DNS zone hosted on a Technitium server (Primary, Secondary, Stub, Forwarder, or Catalog), listed by technitium_dns_list_zones." .

:DnsRecord a owl:Class ;
    rdfs:subClassOf core:ConfigurationItem ;
    rdfs:label "DNS Record" ;
    rdfs:comment "A resource record within a zone (A, AAAA, CNAME, TXT, MX, SRV, NS, CAA, PTR, SOA, …) with a name, type, TTL, and record data (technitium_dns_get_records)." .

:DnssecKey a owl:Class ;
    rdfs:label "DNSSEC Key" ;
    rdfs:comment "A DNSSEC signing key (KSK or ZSK) attached to a signed zone, with its algorithm and lifecycle state (technitium_dns_get_dnssec_properties, technitium_dns_add_private_key)." ;
    rdfs:subClassOf core:Resource .

:DnsServerNode a owl:Class ;
    rdfs:label "DNS Server Node" ;
    rdfs:comment "A Technitium DNS server node/instance that hosts zones and answers queries (the 'node' targeted by tools; stats via technitium_dns_get_stats)." ;
    rdfs:subClassOf core:Server .

:DhcpScope a owl:Class ;
    rdfs:label "DHCP Scope" ;
    rdfs:comment "An address pool the server hands out leases from, with its options and reservations (technitium_dns_list_dhcp_scopes)." ;
    rdfs:subClassOf core:ResourceGroup .

:DhcpLease a owl:Class ;
    rdfs:label "DHCP Lease" ;
    rdfs:comment "An address held by one client in a scope, dynamic or reserved (technitium_dns_list_dhcp_leases)." ;
    rdfs:subClassOf core:ConfigurationItem .

:DnsApp a owl:Class ;
    rdfs:label "DNS App" ;
    rdfs:comment "An app installed on the DNS server, with its configuration (technitium_dns_list_apps)." ;
    rdfs:subClassOf core:SoftwareComponent .

:DnsFilterEntry a owl:Class ;
    rdfs:label "DNS Filter Entry" ;
    rdfs:comment "A domain on the blocked or allowed list (technitium_dns_list_blocked, technitium_dns_list_allowed)." ;
    rdfs:subClassOf core:Policy .

:DnsAdminAccount a owl:Class ;
    rdfs:label "DNS Admin Account" ;
    rdfs:comment "A user or group that can administer the DNS server (technitium_dns_list_users, technitium_dns_list_groups)." ;
    rdfs:subClassOf core:Account .

# --- links (owl:ObjectProperty) ---

:hostedOnNode a owl:ObjectProperty ;
    rdfs:label "hosted on node" ;
    rdfs:comment "Links a DnsZone to the DnsServerNode that serves it authoritatively." ;
    rdfs:domain :DnsZone ;
    rdfs:range :DnsServerNode .

:recordInZone a owl:ObjectProperty ;
    rdfs:label "record in zone" ;
    rdfs:comment "Links a DnsRecord to the DnsZone it belongs to." ;
    rdfs:domain :DnsRecord ;
    rdfs:range :DnsZone .

:signsZone a owl:ObjectProperty ;
    rdfs:label "signs zone" ;
    rdfs:comment "Links a DnssecKey to the DnsZone it signs." ;
    rdfs:domain :DnssecKey ;
    rdfs:range :DnsZone .

:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by" ;
    rdfs:comment "Links a DNS resource to the Person/Agent responsible for it." ;
    rdfs:domain :DnsZone ;
    rdfs:range core:Person .

# --- fields (owl:DatatypeProperty) ---

:technitiumId a owl:DatatypeProperty ;
    rdfs:label "technitium id" ;
    rdfs:comment "External identifier of a Technitium resource (zone name, record fqdn|type, or key tag)." ;
    rdfs:range xsd:string .

:zoneType a owl:DatatypeProperty ;
    rdfs:label "zone type" ;
    rdfs:comment "Technitium zone type: Primary, Secondary, Stub, Forwarder, SecondaryForwarder, Catalog, or SecondaryCatalog." ;
    rdfs:domain :DnsZone ;
    rdfs:range xsd:string .

:dnssecStatus a owl:DatatypeProperty ;
    rdfs:label "dnssec status" ;
    rdfs:comment "DNSSEC state of a zone: Unsigned, SignedWithNSEC, or SignedWithNSEC3." ;
    rdfs:domain :DnsZone ;
    rdfs:range xsd:string .

:disabled a owl:DatatypeProperty ;
    rdfs:label "disabled" ;
    rdfs:comment "Whether the zone or record is currently disabled." ;
    rdfs:range xsd:boolean .

:recordType a owl:DatatypeProperty ;
    rdfs:label "record type" ;
    rdfs:comment "DNS record type (A, AAAA, CNAME, TXT, MX, SRV, NS, CAA, PTR, SOA, …)." ;
    rdfs:domain :DnsRecord ;
    rdfs:range xsd:string .

:recordData a owl:DatatypeProperty ;
    rdfs:label "record data" ;
    rdfs:comment "The record's data payload (rData), rendered as text (e.g. an IP address, target name, or TXT value)." ;
    rdfs:domain :DnsRecord ;
    rdfs:range xsd:string .

:ttl a owl:DatatypeProperty ;
    rdfs:label "ttl" ;
    rdfs:comment "Time-to-live of a DNS record in seconds." ;
    rdfs:domain :DnsRecord ;
    rdfs:range xsd:integer .

:keyType a owl:DatatypeProperty ;
    rdfs:label "key type" ;
    rdfs:comment "DNSSEC key role: KeySigningKey (KSK) or ZoneSigningKey (ZSK)." ;
    rdfs:domain :DnssecKey ;
    rdfs:range xsd:string .

:algorithm a owl:DatatypeProperty ;
    rdfs:label "algorithm" ;
    rdfs:comment "DNSSEC signing algorithm (e.g. ECDSAP256SHA256, RSASHA256)." ;
    rdfs:domain :DnssecKey ;
    rdfs:range xsd:string .

:keyState a owl:DatatypeProperty ;
    rdfs:label "key state" ;
    rdfs:comment "DNSSEC key lifecycle state (Ready, Active, Published, Retired, Revoked)." ;
    rdfs:domain :DnssecKey ;
    rdfs:range xsd:string .

<https://knuckles-team.github.io/ontology/connector/technitium> a owl:Ontology ;
    rdfs:label "Technitium DNS Ontology" ;
    rdfs:comment """Technitium DNS domain extensions federated into the scion-sdk
    knowledge-graph hub: authoritative zones, records, DNSSEC keys, and the server node
    that hosts them.""" .
